{
  "name": "legalhigh-desktop",
  "version": "1.1.0-rc.1",
  "description": "LegalHigh 桌面端：FastAPI 本机 sidecar + Web 前端；数据默认本机处理，只有用户明确配置并授权远程模型时才向该端点发送输入",
  "main": "main.js",
  "author": "LegalHigh",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rethymus/LegalHigh.git"
  },
  "scripts": {
    "materialize-main": "node -e \"require('fs').copyFileSync('main.js.in','main.js')\"",
    "check": "npm run materialize-main && node --check main.js",
    "predist": "npm run materialize-main",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.legalhigh.desktop",
    "productName": "LegalHigh",
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
