{
  "name": "legalhigh-desktop",
  "version": "0.1.0",
  "description": "LegalHigh 桌面端：本地全功能运行（FastAPI sidecar + Web 前端），数据不出本机",
  "main": "main.js",
  "author": "LegalHigh",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rethymus/LegalHigh.git"
  },
  "scripts": {
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.legalhigh.desktop",
    "productName": "LegalHigh",
    "files": ["main.js", "backend/**"],
    "extraResources": [
      { "from": "backend", "to": "backend" }
    ],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
